@{
    ViewData["Title"] = "Начало";
}

<header class="hero-section">
    <div class="hero-overlay"></div>

    <div class="hero-content">
        <h1>Кулинарницата</h1>
        <p>Вкусът на Гърция в твоя град</p>
        <a href="/Reservations" class="hero-btn">Резервирай сега</a>
    </div>
</header>

<!-- ПОПУЛЯРНИ ЯСТИЯ -->
<section class="menu-section">
    <div class="container">
        <h2 class="section-title">Популярни ястия</h2>

        <div class="master-grid">

            <div class="master-card">
                <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38" />
                <div class="master-card-body">
                    <h3>Гръцка салата</h3>
                    <p>Свежи зеленчуци и сирене Фета</p>
                    <p class="price">12.90 лв.</p>
                </div>
            </div>

            <div class="master-card">
                <img src="https://images.unsplash.com/photo-1586190848861-99aa4a171e90" />
                <div class="master-card-body">
                    <h3>Мусака</h3>
                    <p>Традиционна гръцка мусака</p>
                    <p class="price">18.50 лв.</p>
                </div>
            </div>

            <div class="master-card">
                <img src="https://images.unsplash.com/photo-1599974571344-2c796844c34c" />
                <div class="master-card-body">
                    <h3>Сувлаки</h3>
                    <p>Гриловано месо на шиш</p>
                    <p class="price">16.90 лв.</p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- НАПИТКИ -->
<section class="menu-section">
    <div class="container">
        <h2 class="section-title">Напитки</h2>

        <div class="master-grid">

            <div class="master-card">
                <img src="https://images.unsplash.com/photo-1551024506-0bccd828d307" />
                <div class="master-card-body">
                    <h3>Гръцко вино</h3>
                    <p class="price">24.90 лв.</p>
                </div>
            </div>

            <div class="master-card">
                <img src="https://images.unsplash.com/photo-1544145945-f90425340c7e" />
                <div class="master-card-body">
                    <h3>Фреш портокал</h3>
                    <p class="price">6.50 лв.</p>
                </div>
            </div>

            <div class="master-card">
                <img src="https://images.unsplash.com/photo-1550989460-0adf9ea622e2" />
                <div class="master-card-body">
                    <h3>Гръцка бира</h3>
                    <p class="price">8.90 лв.</p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta-section">
    <div class="cta-content">
        <h2>Готови за гръцко преживяване?</h2>
        <a href="/Reservations" class="hero-btn">Резервирай сега</a>
    </div>
</section>