@model IEnumerable<ASPRestaurant.Data.Drink>

@{
	var grouped = Model.GroupBy(x => x.TypeOrders?.Name ?? "Без категория");
}

<div class="container py-4">

	<h1 class="section-title text-center mb-4">Меню напитки</h1>

	@if (User.IsInRole("Admin"))
	{
		<div class="text-center mb-4">
			<a asp-action="Create" class="btn btn-primary">Добави напитка</a>
		</div>
	}

	<div class="row justify-content-center mb-4">

		<div class="col-md-4">
			<input id="drinkSearch" class="form-control" placeholder="Търси напитка..." />
		</div>

		<div class="col-md-4">
			<select id="drinkCategory" class="form-control">

				<option value="">Всички категории</option>

				@foreach (var g in grouped.Select(x => x.Key))
				{
					<option value="@g">@g</option>
				}

			</select>
		</div>

	</div>

	@foreach (var group in grouped)
	{
		<h2 class="category-title text-center mt-4 mb-3">@group.Key</h2>

		<div class="row justify-content-center">

			@foreach (var item in group)
			{
				<div class="col-lg-3 col-md-4 col-sm-6 mb-4 drink-item">

					<div class="master-card"
						 data-name="@item.Name"
						 data-category="@item.TypeOrders?.Name">

						<img src="@(string.IsNullOrEmpty(item.CoverImage)
													 		 ? "https://via.placeholder.com/300x200"
													 		 : item.CoverImage)" />

				<div class="master-card-body">

							<h3>@item.Name</h3>

							<p>
								📝 Описание: @item.Description
							</p>

							<p>
								🥤 Количество: @item.Litre ml
							</p>

							<p>
								⚖️ Цена: @(item.Price?.ToString("0.00") ?? "0.00") €
							</p>


						</div>
						<div class="drink-actions">

							<a asp-action="Details"
							   asp-route-id="@item.Id"
							   class="btn btn-info btn-sm">
								Детайли
							</a>

					@if (User.IsInRole("Admin"))
							{
								<a asp-action="Edit"
								   asp-route-id="@item.Id"
								   class="btn btn-warning btn-sm">
									Редакция
								</a>

								<a asp-action="Delete"
								   asp-route-id="@item.Id"
								   class="btn btn-danger btn-sm">
									Изтрий
								</a>
							}

						</div>

					</div>

				</div>
			}


		</div>
	}

</div>

<script>

	var search = document.getElementById("drinkSearch");
	var category = document.getElementById("drinkCategory");
	var items = document.getElementsByClassName("drink-item");

	function filter() {

		var text = search.value.toLowerCase();
		var cat = category.value.toLowerCase();

		for (var i = 0; i < items.length; i++) {

			var card = items[i].querySelector(".master-card");

			var name = card.getAttribute("data-name").toLowerCase();
			var categoryValue = card.getAttribute("data-category").toLowerCase();

			var matchSearch = name.startsWith(text);

			var matchCategory = (cat == "" || categoryValue == cat);

			if (matchSearch && matchCategory) {
				items[i].style.display = "";
			} else {
				items[i].style.display = "none";
			}
		}
	}

	search.addEventListener("input", filter);
	category.addEventListener("change", filter);

</script>