@model ASPRestaurant.Data.Drink

@{
    ViewData["Title"] = "Изтрий напитка";
}

<div class="delete-page">
    <div class="delete-card">
        <h2>Потвърдете изтриване</h2>
        <p>Сигурни ли сте, че искате да изтриете тази напитка?</p>
        
        <div class="delete-details">
            <h3>@Model.Name</h3>
            
            <dl>
                <dt>Описание</dt>
                <dd>@Model.Description</dd>

                <dt>Цена</dt>
                <dd>@Model.Price.ToString("F2") €</dd>

                <dt>Количество</dt>
                <dd>@Model.Litre L</dd>

                <dt>Тип</dt>
                <dd>
                    @if (!string.IsNullOrEmpty(Model.TypeOrders?.Name) &&
                                        Model.TypeOrders.Name.ToLower().Contains("алкохол"))
                    {
                        <span class="status-badge status-available">Алкохолна напитка</span>
                    }
                    else
                    {
                        <span class="status-badge status-pending">Безалкохолна напитка</span>
                    }
                </dd>

                <dt>Категория</dt>
                <dd>@Model.TypeOrders?.Name</dd>
            </dl>
            @if (!string.IsNullOrEmpty(Model.CoverImage))
            {
                <div class="mt-3">
                    <h4>Текуща снимка</h4>
                    <img src="@Model.CoverImage" alt="@Model.Name" class="img-thumbnail" style="max-width: 150px; max-height: 150px;" />
                </div>
            }
        </div>
        
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div class="delete-actions">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Изтрий
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Отмени
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Назад
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Анимация при зареждане
        document.addEventListener('DOMContentLoaded', function() {
            const card = document.querySelector('.delete-card');
            card.style.animation = 'fadeInUp 0.6s ease-out';
        });
    </script>
}