@model ASPRestaurant.Data.Drink

@{
    ViewData["Title"] = Model.Name;
}

<div class="details-wrapper">

    <div class="details-card">

        <div class="details-image">
            <img src="@(Model.CoverImage ?? "https://via.placeholder.com/600x400")"
                 alt="@Model.Name" />
        </div>

        <div class="details-body">

            <h1 class="details-title">@Model.Name</h1>

            <p class="details-desc">
                @(string.IsNullOrWhiteSpace(Model.Description)
                                ? "Няма описание"
                                : Model.Description)
            </p>

            <div class="details-info">

                <div class="info-box">
                    🥤 Литри: <strong>@Model.Litre.ToString("0.000") L</strong>
                </div>

                <div class="info-box">
                    📦 Категория: <strong>@Model.TypeOrders?.Name</strong>
                </div>

                <div class="info-box">
                    💰 Цена: <strong>@Model.Price.ToString("0.00") €</strong>
                </div>

            </div>

            <div class="details-actions">
                <a href="javascript:history.back()" class="btn-back">
                    ← Назад
                </a>
            </div>

        </div>

    </div>

</div>
