@model ASPRestaurant.Data.Drink

@{
    ViewData["Title"] = Model.Name;
}

<div class="details-wrapper">

    <div class="details-card">

        <div class="details-image">
            <img src="@(Model.CoverImage ?? "https://via.placeholder.com/600x400")" />
        </div>

        <div class="details-body">

            <h1>@Model.Name</h1>

            <p class="details-desc">
                @Model.Description
            </p>

            <div class="details-info">

                <div class="info-box">
                    🥤 Литри: @Model.Litre L
                </div>

                <div class="info-box">
                    📦 Категория: @Model.TypeOrders?.Name
                </div>

                <div class="info-box">
                    💰 Цена: @Model.Price.ToString("F2") €
                </div>

            </div>

            <div class="details-actions">
                <a href="javascript:history.back()" class="btn-back">← Назад</a>
            </div>

        </div>

    </div>

</div>