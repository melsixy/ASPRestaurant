@model ASPRestaurant.Data.Reservation

@{
    ViewData["Title"] = "Edit";
}

<div class="form-page">
    <div class="form-card">

        <h1>Edit</h1>
        <h4>Reservation</h4>

        <form asp-action="Edit">

            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="NumberOfPeople"></label>
                <input asp-for="NumberOfPeople" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Date"></label>
                <input asp-for="Date" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Time"></label>
                <input asp-for="Time" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="TableId"></label>
                <select asp-for="TableId" class="form-control" asp-items="ViewBag.TableId"></select>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>

        </form>

        <a asp-action="Index" class="btn btn-secondary mt-2">Back</a>

    </div>
</div>
