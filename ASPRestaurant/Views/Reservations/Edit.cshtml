@model ASPRestaurant.Data.Reservation

@{
    ViewData["Title"] = "Редактирай";
}

<div class="reservation-modern">

    <div class="reservation-card">

        <h1>Редакция на резервация</h1>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <input type="hidden" asp-for="Id" />


            <div class="row">
                <div class="col-md-6">
                    <label class="form-label">Дата</label>
                    <input asp-for="Date" type="date" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Час</label>
                    <input asp-for="Time" type="time" class="form-control" />
                </div>
            </div>

            <div class="mt-3">
                <label class="form-label">Брой хора</label>
                <input asp-for="NumberOfPeople" type="number" class="form-control" min="1" />
            </div>

            <input type="hidden" asp-for="TableId" id="TableId" />

            <h3 class="mt-4">Избери място</h3>

            <div class="table-modern-grid">

                <div class="table-modern @(Model.TableId == 1 ? "selected" : "")" onclick="selectTable(1)">
                    <img src="/images/seaview.png" />
                    <div class="overlay">🌊 Гледка към морето</div>
                </div>

                <div class="table-modern @(Model.TableId == 2 ? "selected" : "")" onclick="selectTable(2)">
                    <img src="/images/beachview.png" />
                    <div class="overlay">🏖 Плаж</div>
                </div>

                <div class="table-modern @(Model.TableId == 3 ? "selected" : "")" onclick="selectTable(3)">
                    <img src="/images/gardenview.jpg" />
                    <div class="overlay">🌿 Градина</div>
                </div>

                <div class="table-modern @(Model.TableId == 4 ? "selected" : "")" onclick="selectTable(4)">
                    <img src="/images/interior.jpg" />
                    <div class="overlay">🌇 Тераса</div>
                </div>

            </div>

            <button type="submit" class="btn btn-primary w-100 mt-4">
                Запази промените
            </button>

            <a asp-action="Index" class="btn btn-secondary w-100 mt-2">
                Назад
            </a>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        function selectTable(id) {
            document.getElementById("TableId").value = id;

            document.querySelectorAll(".table-modern")
                .forEach(x => x.classList.remove("selected"));

            event.currentTarget.classList.add("selected");
        }
    </script>
}