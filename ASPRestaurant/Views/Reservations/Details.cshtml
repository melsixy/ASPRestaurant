@model ASPRestaurant.Data.Reservation

@{
    ViewData["Title"] = "Детайли";
}

<div class="details-wrapper">

    <div class="details-card">

        <div class="details-body">

            <h1>Резервация</h1>

            <div class="details-info">

                <div class="info-box">👤 @Model.Clients?.UserName</div>

                <div class="info-box">🍽 Маса @Model.TableId</div>

                <div class="info-box">👥 @Model.NumberOfPeople души</div>

                <div class="info-box">📅 @Model.Date.ToShortDateString()</div>

                <div class="info-box">⏰ @Model.Time</div>

            </div>

            <div class="details-actions">
                <a href="javascript:history.back()" class="btn-back">← Назад</a>
            </div>

        </div>

    </div>

</div>

