@model ASPRestaurant.Data.Reservation

@{
    ViewData["Title"] = "Details";
}

<div class="details-page">

    <div class="details-card">

        <h2>Резервация</h2>

        <p class="text-muted">Детайли за резервацията</p>

        <hr />

        <div class="reservation-info">

            <div class="info-row">
                <span>Хора:</span>
                <b>@Model.NumberOfPeople</b>
            </div>

            <div class="info-row">
                <span>Дата:</span>
                <b>@Model.Date.ToShortDateString()</b>
            </div>

            <div class="info-row">
                <span>Час:</span>
                <b>@Model.Time</b>
            </div>

            <div class="info-row">
                <span>🪑 Маса:</span>
                <b>@Model.Tables?.TableNumber</b>
            </div>

            <div class="info-row">
                <span>Клиент:</span>
                <b>@Model.Clients?.UserName</b>
            </div>

            <div class="info-row">
                <span>Създадена:</span>
                <b>@Model.RegisterOn</b>
            </div>

        </div>

        <div class="details-actions mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                Редактирай
            </a>

            <a asp-action="Index" class="btn btn-secondary">
                Назад
            </a>
        </div>

    </div>

</div>

