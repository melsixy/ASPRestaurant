@model ASPRestaurant.Data.Reservation

@{
    ViewData["Title"] = "Детайли за резервация";
}

<div class="details-page">
    <div class="details-card">
        <div class="details-body">
            <h1 class="details-title">Резервация #@Model.Id</h1>
            
            <div class="details-info">
                <div class="info-item">
                    <div class="info-label">Дата</div>
                    <div class="info-value">@Model.Date.ToString("dd.MM.yyyy")</div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Час</div>
                    <div class="info-value">@Model.Time.ToString(@"hh\:mm")</div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Брой хора</div>
                    <div class="info-value">@Model.NumberOfPeople</div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Маса</div>
                    <div class="info-value">
                        @if (Model.Tables != null)
                        {
                            <span class="status-badge status-available">Маса @Model.Tables.TableNumber</span>
                            <small class="text-muted">@Model.Tables.Description</small>
                        }
                        else
                        {
                            <span class="text-muted">Без маса</span>
                        }
                    </div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Клиент</div>
                    <div class="info-value">@Model.Clients?.UserName</div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Статус</div>
                    <div class="info-value">
                        @{
                            var start = Model.Date.Date.Add(Model.Time);
                            var end = start.AddHours(2);
                            var now = DateTime.Now;
                        }

                        @if (now >= start && now <= end)
                        {
                            <span class="status-badge status-busy">Активна</span>
                        }
                        else if (Model.Date > DateTime.Now)
                        {
                            <span class="status-badge status-pending">Предстояща</span>
                        }
                        else
                        {
                            <span class="status-badge status-available">Завършена</span>
                        }
                    </div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Регистрирана на</div>
                    <div class="info-value">@Model.RegisterOn.ToString("dd.MM.yyyy HH:mm")</div>
                </div>
            </div>
            
            <div class="details-actions">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="fas fa-edit"></i> Редактирай
                    </a>
                    
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Изтрий
                    </a>
                }
                
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Назад
                </a>
                
                <button class="btn btn-success" onclick="window.print()">
                    <i class="fas fa-print"></i> Принтирай
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Анимация при зареждане
        document.addEventListener('DOMContentLoaded', function() {
            const card = document.querySelector('.details-card');
            card.style.animation = 'fadeInUp 0.8s ease-out';
        });
    </script>
}

