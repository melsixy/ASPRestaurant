@model IEnumerable<ASPRestaurant.Data.Reservation>

@{
    ViewData["Title"] = "Резервации";
}

<div class="grid-container">
    <h1 class="section-title">Резервации</h1>
    
    <!-- Филтри и търсене -->
    <div class="filter-section mb-4">
        <div class="row">
            <div class="col-md-3">
                <input type="date" class="form-control" id="dateFilter" placeholder="Дата">
            </div>
            <div class="col-md-3">
                <input type="time" class="form-control" id="timeFilter" placeholder="Час">
            </div>
            <div class="col-md-3">
                <select class="form-control" id="statusFilter">
                    <option value="">Всички статуси</option>
                    <option value="pending">Предстоящи</option>
                    <option value="confirmed">Потвърдени</option>
                    <option value="completed">Завършени</option>
                    <option value="cancelled">Отменени</option>
                </select>
            </div>
            <div class="col-md-3">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Търси по клиент..." id="searchInput">
                    <button class="btn btn-primary" type="button">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="text-center mb-4">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Нова резервация
            </a>
        </div>
    }

    <!-- Таблица с резервации -->
    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>Дата</th>
                    <th>Час</th>
                    <th>Клиент</th>
                    <th>Брой хора</th>
                    <th>Маса</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reservation in Model)
                {
                    <tr>
                        <td>@reservation.Date.ToString("dd.MM.yyyy")</td>
                        <td>@reservation.Time.ToString(@"hh\:mm")</td>
                        <td>@reservation.Clients?.UserName</td>
                        <td>@reservation.NumberOfPeople</td>
                        <td>
                            @if (reservation.Tables != null)
                            {
                                <span class="status-badge status-available">Маса @reservation.Tables.TableNumber</span>
                            }
                            else
                            {
                                <span class="text-muted">Без маса</span>
                            }
                        </td>
                        <td>
                            @{
                                var start = reservation.Date.Date.Add(reservation.Time);
                                var end = start.AddHours(2);
                                var now = DateTime.Now;
                            }

                            @if (now >= start && now <= end)
                            {
                                <span class="status-badge status-busy">Заета</span>
                            }
                            else if (reservation.Date > DateTime.Now)
                            {
                                <span class="status-badge status-pending">Предстояща</span>
                            }
                            else
                            {
                                <span class="status-badge status-available">Завършена</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@reservation.Id" class="btn btn-sm btn-primary">
                                    <i class="fas fa-eye"></i>
                                </a>
                                
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@reservation.Id" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    
                                    <a asp-action="Delete" asp-route-id="@reservation.Id" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Пагинация -->
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item disabled">
                <a class="page-link" href="#" tabindex="-1">Previous</a>
            </li>
            <li class="page-item active">
                <a class="page-link" href="#">1</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="#">2</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="#">3</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="#">Next</a>
            </li>
        </ul>
    </nav>
</div>

@section Scripts {
    <script>
        // Филтриране и търсене
        document.getElementById('dateFilter').addEventListener('change', filterReservations);
        document.getElementById('timeFilter').addEventListener('change', filterReservations);
        document.getElementById('statusFilter').addEventListener('change', filterReservations);
        document.getElementById('searchInput').addEventListener('input', filterReservations);

        function filterReservations() {
            const date = document.getElementById('dateFilter').value;
            const time = document.getElementById('timeFilter').value;
            const status = document.getElementById('statusFilter').value;
            const search = document.getElementById('searchInput').value.toLowerCase();
            
            const rows = document.querySelectorAll('tbody tr');
            
            rows.forEach(row => {
                const cells = row.querySelectorAll('td');
                const rowDate = cells[0]?.textContent;
                const rowTime = cells[1]?.textContent;
                const rowClient = cells[2]?.textContent.toLowerCase();
                const rowStatus = cells[5]?.textContent.toLowerCase();
                
                let showRow = true;
                
                if (date && !rowDate.includes(date)) showRow = false;
                if (time && !rowTime.includes(time)) showRow = false;
                if (status && !rowStatus.includes(status)) showRow = false;
                if (search && !rowClient.includes(search)) showRow = false;
                
                row.style.display = showRow ? '' : 'none';
            });
        }
    </script>
}
