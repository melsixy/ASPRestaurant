@model IEnumerable<ASPRestaurant.Data.Reservation>

@{
    ViewData["Title"] = "Резервации";
}

<div class="grid-container">

    <h1 class="section-title">Резервации</h1>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="text-center mb-3">
            <a asp-action="Create" class="btn btn-primary">
                Нова резервация
            </a>
        </div>
    }

    <!-- FILTERS -->
    <div class="filter-section mb-4">
        <div class="row">

            <div class="col-md-3">
                <input type="date" class="form-control" id="dateFilter">
            </div>

            <div class="col-md-3">
                <input type="time" class="form-control" id="timeFilter">
            </div>

            <div class="col-md-3">
                <select class="form-control" id="statusFilter">
                    <option value="">Всички</option>
                    <option value="pending">Предстоящи</option>
                    <option value="active">Активни</option>
                    <option value="completed">Завършени</option>
                </select>
            </div>

            <div class="col-md-3">
                <input type="text" class="form-control" id="searchInput" placeholder="Клиент...">
            </div>

        </div>
    </div>

    <!-- TABLE -->
    <div class="table-container">
        <table class="table">

            <thead>
                <tr>
                    <th>Дата</th>
                    <th>Час</th>
                    <th>Клиент</th>
                    <th>Брой</th>
                    <th>Маса</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var reservation in Model)
                {
                    var start = reservation.Date.Date.Add(reservation.Time);
                    var end = start.AddHours(2);

                    var status =
                    DateTime.Now < start ? "pending" :
                    DateTime.Now > end ? "completed" :
                    "active";

                    <tr data-date="@reservation.Date.ToString("yyyy-MM-dd")"
                        data-time="@reservation.Time.ToString(@"hh\:mm")"
                        data-client="@reservation.Clients?.UserName"
                        data-status="@status">

                        <td>@reservation.Date.ToString("dd.MM.yyyy")</td>
                        <td>@reservation.Time.ToString(@"hh\:mm")</td>
                        <td>@reservation.Clients?.UserName</td>
                        <td>@reservation.NumberOfPeople</td>
                        <td>Маса @reservation.Tables?.TableNumber</td>

                        <td>
                            @if (status == "active")
                            {
                                <span class="badge bg-danger">Активна</span>
                            }
                            else if (status == "pending")
                            {
                                <span class="badge bg-warning">Предстояща</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Завършена</span>
                            }
                        </td>

                        <td>
                            <a asp-action="Details" asp-route-id="@reservation.Id" class="btn btn-primary btn-sm">
                                Детайли
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@reservation.Id" class="btn btn-warning btn-sm">
                                    Редакция
                                </a>

                                <a asp-action="Delete" asp-route-id="@reservation.Id" class="btn btn-danger btn-sm">
                                    Изтрий
                                </a>
                            }
                        </td>

                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>

<!-- FILTER SCRIPT -->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const dateFilter = document.getElementById("dateFilter");
        const timeFilter = document.getElementById("timeFilter");
        const searchInput = document.getElementById("searchInput");
        const statusFilter = document.getElementById("statusFilter");

        const rows = document.querySelectorAll("tbody tr");

        function filter() {

            const date = dateFilter.value;
            const time = timeFilter.value;
            const search = searchInput.value.toLowerCase();
            const status = statusFilter.value;

            rows.forEach(row => {

                const rDate = row.dataset.date;
                const rTime = row.dataset.time;
                const rClient = row.dataset.client?.toLowerCase() || "";
                const rStatus = row.dataset.status;

                let show = true;

                if (date && rDate !== date) show = false;
                if (time && !rTime.startsWith(time)) show = false;
                if (search && !rClient.includes(search)) show = false;
                if (status && rStatus !== status) show = false;

                row.style.display = show ? "" : "none";
            });
        }

        dateFilter.addEventListener("input", filter);
        timeFilter.addEventListener("input", filter);
        searchInput.addEventListener("input", filter);
        statusFilter.addEventListener("change", filter);
    });
</script>