
@{
    ViewData["Title"] = "Резервации";
}

<h2>Моите резервации</h2>

<table class="table">
    <tr>
        <th>Дата</th>
        <th>Час</th>
        <th>Маса</th>
        <th>Хора</th>
    </tr>

    @foreach (var r in Model)
    {
        <tr>
            <td>@r.Date.ToShortDateString()</td>
            <td>@r.Time</td>
            <td>@r.Tables.TableNumber</td>
            <td>@r.NumberOfPeople</td>
        </tr>
    }
</table>