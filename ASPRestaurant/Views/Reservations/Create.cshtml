@model ASPRestaurant.Data.Reservation

@{
    ViewData["Title"] = "Нова резервация";
}

<div class="reservation-modern">

    <div class="reservation-card">

        <h1>Направете резервация</h1>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- DATE / TIME -->
            <div class="row">
                <div class="col-md-6">
                    <label>Дата</label>
                    <input asp-for="Date" type="date" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label>Час</label>
                    <input asp-for="Time" type="time" class="form-control" />
                </div>
            </div>

            <!-- PEOPLE -->
            <div class="mt-3">
                <label>Брой хора</label>
                <input asp-for="NumberOfPeople" type="number" class="form-control" min="1" max="20" />
            </div>

            <!-- hidden TableId -->
            <input type="hidden" asp-for="TableId" id="TableId" />

            <!-- ZONES -->
            <h3 class="mt-4">Избери място</h3>

            <div class="table-modern-grid">

                <div class="table-modern" onclick="selectTable(1)">
                    <img src="/images/seaview.png" />
                    <div class="overlay">🌊 Гледка към морето</div>
                </div>

                <div class="table-modern" onclick="selectTable(2)">
                    <img src="/images/beachview.png" />
                    <div class="overlay">🏖 Плаж</div>
                </div>

                <div class="table-modern" onclick="selectTable(3)">
                    <img src="/images/gardenview.jpg" />
                    <div class="overlay">🌿 Градина</div>
                </div>

                <div class="table-modern" onclick="selectTable(4)">
                    <img src="/images/interior.jpg" />
                    <div class="overlay">🌇 Тераса</div>
                </div>

            </div>

            <button type="submit" class="btn btn-primary w-100 mt-4">
                Запази резервация
            </button>

        </form>

    </div>

</div>

@section Scripts {
<script>
function selectTable(id) {

    document.getElementById("TableId").value = id;

    document.querySelectorAll(".table-modern")
        .forEach(x => x.classList.remove("selected"));

    event.currentTarget.classList.add("selected");
}
</script>
}