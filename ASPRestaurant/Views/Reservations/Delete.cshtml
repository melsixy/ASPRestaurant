@model ASPRestaurant.Data.Reservation

@{
    ViewData["Title"] = "Изтрий резервация";
}

<div class="delete-page">
    <div class="delete-card">

        <h1>Изтриване на резервация</h1>

        <p>
            Сигурни ли сте, че искате да изтриете тази резервация?
        </p>

        <div class="reservation-info-box">

            <div class="info-item">
                <span>📅 Дата</span>
                <strong>@Model.Date.ToString("dd.MM.yyyy")</strong>
            </div>

            <div class="info-item">
                <span>⏰ Час</span>
                <strong>@Model.Time.ToString(@"hh\:mm")</strong>
            </div>

            <div class="info-item">
                <span>👥 Брой хора</span>
                <strong>@Model.NumberOfPeople</strong>
            </div>

            <div class="info-item">
                <span>🍽️ Маса</span>

                @if (Model.Tables != null)
                {
                    <strong>
                        Маса @Model.Tables.TableNumber
                    </strong>
                }
                else
                {
                    <strong>Без маса</strong>
                }
            </div>

            <div class="info-item">
                <span>👤 Клиент</span>
                <strong>@Model.Clients?.UserName</strong>
            </div>

            <div class="info-item">
                <span>🕒 Създадена</span>
                <strong>@Model.RegisterOn.ToString("dd.MM.yyyy, HH:mm ч.")</strong>
            </div>

        </div>

        <form asp-action="Delete" method="post">


            <div class="delete-buttons">

                <button type="submit" class="btn btn-danger">
                    Изтрий
                </button>


                <a asp-action="Index"
                   class="btn btn-outline-primary">
                    Назад
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const card = document.querySelector(".reservation-delete-card");

            card.style.opacity = "0";
            card.style.transform = "translateY(40px)";

            setTimeout(() => {
                card.style.transition = "0.5s ease";
                card.style.opacity = "1";
                card.style.transform = "translateY(0)";
            }, 100);

        });
    </script>
}