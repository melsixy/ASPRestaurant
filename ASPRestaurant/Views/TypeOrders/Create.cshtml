@model ASPRestaurant.Data.TypeOrder

@{
    ViewData["Title"] = "Добави категория";
}

<div class="category-page">

    <div class="category-form-card">

        <h1>Добави категория</h1>
        <p class="subtitle">Създаване на нова категория</p>

        <form asp-action="Create">

            <div class="form-group mb-3">
                <label class="form-label">Име на категория</label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="Например: Напитки" />

                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Запази
            </button>

        </form>

        <a asp-action="Index" class="btn btn-secondary w-100 mt-3">
            Назад
        </a>

    </div>

</div>