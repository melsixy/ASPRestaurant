@model ASPRestaurant.Data.TypeOrder

@{
    ViewData["Title"] = "Details";
}

<div class="details-page">

    <div class="details-card">

        <h2>Категория</h2>

        <p class="text-muted">Тип на поръчка / меню</p>

        <hr />

        <div class="reservation-info">

            <div class="info-row">
                <span>Име:</span>
                <b>@Model.Name</b>
            </div>

            <div class="info-row">
                <span>Създадена:</span>
                <b>@Model.RegisterOn</b>
            </div>

        </div>

        <div class="details-actions mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                Редактирай
            </a>

            <a asp-action="Index" class="btn btn-secondary">
                Назад
            </a>
        </div>

    </div>

</div>
