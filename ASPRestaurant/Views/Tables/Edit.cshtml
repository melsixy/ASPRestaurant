@model ASPRestaurant.Data.Table

@{
    ViewData["Title"] = "Редактирай";
}

<div class="reservation-modern">

    <div class="reservation-card">

        <h1>Редакция</h1>

        <form asp-action="Edit">

            <input type="hidden" asp-for="Id" />

            <div class="mt-3">
                <label class="form-label">Описание</label>
                <input asp-for="Description" class="form-control" />
            </div>

            <div class="mt-3">
                <label class="form-label">Номер на маса</label>
                <input asp-for="TableNumber" class="form-control" />
            </div>

            <div class="mt-3">
                <label class="form-label">Брой места</label>
                <input asp-for="Count" class="form-control" />
            </div>

            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-primary w-100 mt-4">
                Запази
            </button>

            <a asp-action="Index" class="btn btn-secondary w-100 mt-2">
                Назад
            </a>

        </form>

    </div>

</div>

@section Scripts {
    <script>
        function selectTable(id) {
            document.getElementById("TableId").value = id;

            document.querySelectorAll(".table-modern")
                .forEach(x => x.classList.remove("selected"));

            event.currentTarget.classList.add("selected");
        }
    </script>
}