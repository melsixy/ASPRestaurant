@model ASPRestaurant.Data.Table

@{
    ViewData["Title"] = "Детайли за маса";
}

<div class="details-wrapper">

    <div class="details-card">

        <div class="details-body">

            <h1>Маса @Model.TableNumber</h1>

            <p class="details-desc">@Model.Description</p>

            <div class="details-info">
                <div class="info-box">👥 @Model.Count места</div>

                <div class="info-box @(Model.IsAvailable ? "free" : "reserved")">
                    @(Model.IsAvailable ? "Свободна" : "Заета")
                </div>
            </div>

            <div class="details-actions">
                <a href="javascript:history.back()" class="btn-back">← Назад</a>

                @if (Model.IsAvailable)
                {
                    <a href="/Reservations/Create?tableId=@Model.Id"
                       class="btn-edit">
                        Резервирай
                    </a>
                }
            </div>

        </div>

    </div>

</div>
