@model ASPRestaurant.Data.Table

@{
    ViewData["Title"] = "Нова маса";
}

<div class="reservation-modern">

    <div class="reservation-card">

        <h1>Добави маса</h1>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- NUMBER -->
            <div class="form-group">
                <label asp-for="TableNumber">Номер на маса</label>
                <input asp-for="TableNumber" class="form-control" />
            </div>

            <!-- CAPACITY -->
            <div class="form-group mt-2">
                <label asp-for="Count">Капацитет</label>
                <input asp-for="Count" class="form-control" />
            </div>

            <!-- DESCRIPTION -->
            <div class="form-group mt-2">
                <label asp-for="Description">Описание</label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>

            <!-- hidden field for zone -->
            <input type="hidden" id="Zone" name="Zone" />

            <h3 class="mt-4">Избери местоположение</h3>

            <div class="table-modern-grid">

                <div class="table-modern" onclick="selectZone('sea', this)">
                    <img src="/images/seaview.png" />
                    <div class="overlay">🌊 Гледка към море</div>
                </div>

                <div class="table-modern" onclick="selectZone('beach', this)">
                    <img src="/images/beachview.png" />
                    <div class="overlay">🏖 Плаж</div>
                </div>

                <div class="table-modern" onclick="selectZone('garden', this)">
                    <img src="/images/gardenview.jpg" />
                    <div class="overlay">🌿 Градина</div>
                </div>

                <div class="table-modern" onclick="selectZone('terrace', this)">
                    <img src="/images/interior.jpg" />
                    <div class="overlay">🌇 Тераса</div>
                </div>

            </div>

            <button type="submit" class="btn btn-primary w-100 mt-4">
                Запази маса
            </button>

        </form>

    </div>

</div>

@section Scripts {
<script>
function selectZone(zone, el) {

    document.getElementById("Zone").value = zone;

    document.querySelectorAll(".table-modern")
        .forEach(x => x.classList.remove("selected"));

    el.classList.add("selected");
}
</script>
}