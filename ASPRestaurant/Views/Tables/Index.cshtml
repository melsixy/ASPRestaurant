@model IEnumerable<ASPRestaurant.Data.Table>

@{
    ViewData["Title"] = "Маси";
}

<h1 class="section-title">Маси</h1>

<div class="filter-section mb-4">
    <div class="row justify-content-center">

        <div class="col-md-4 mb-2">
            <input type="text" class="form-control" placeholder="Търси по номер..." id="searchInput">
        </div>

        <div class="col-md-4 mb-2">
            <select class="form-control" id="statusFilter">
                <option value="">Всички маси</option>
                <option value="available">Свободни</option>
                <option value="unavailable">Заети</option>
            </select>
        </div>

    </div>
</div>

@if (User.IsInRole("Admin"))
{
    <div class="text-center mb-4">
        <a asp-action="Create" class="btn btn-primary">Нова маса</a>
    </div>
}


<div class="table-modern-grid">

    @foreach (var item in Model)
    {
        var now = DateTime.Now;

        bool isAvailable = !(item.Reservations?.Any(r =>
        {
            var start = r.Date.Date + r.Time;
            var end = start.AddHours(2).AddMinutes(10);

            return now >= start && now <= end;
        }) ?? false);

        @if (TempData["ErrorTableId"] != null &&
            (int)TempData["ErrorTableId"] == item.Id)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (TempData["SuccessTableId"] != null &&
            (int)TempData["SuccessTableId"] == item.Id)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="table-modern-card @(isAvailable ? "free" : "busy")"
             data-number="@item.TableNumber"
             data-status="@(isAvailable ? "available" : "unavailable")">

            <img src="@GetTableImage(item.Description ?? "")" />

            <div class="overlay">

                <h3>Маса @item.TableNumber</h3>

                <p>
                    @if (!string.IsNullOrEmpty(item.Description))
                    {
                        @item.Description
                    }
                    else
                    {
                        <span>Без зона</span>
                    }
                </p>

                <div class="table-capacity">
                    👥 @item.Count места
                </div>

                <span class="status-chip @(isAvailable ? "green" : "red")">
                    @(isAvailable ? "Свободна" : "Заета")
                </span>

                @if (User.Identity.IsAuthenticated)
                {
                    <form asp-controller="Reservations" asp-action="QuickReserve" method="post">
                        <input type="hidden" name="tableId" value="@item.Id" />

                        <button type="submit" class="btn btn-success w-100">
                            Резервирай
                        </button>
                    </form>
                }
                else
                {
                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       asp-route-returnUrl="@Url.Action("Create", "Reservations", new { tableId = item.Id })"
                       class="btn btn-warning w-100 mt-2">
                        Вход за резервация
                    </a>
                }

                <div class="drink-actions">

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Редакция
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Изтрий
                        </a>
                    }

                </div>
            </div>
        </div>
    }
    <script>
        const searchInput = document.getElementById("searchInput");
        const statusFilter = document.getElementById("statusFilter");
        const tableCards = document.querySelectorAll(".table-modern-card");

        function filterTables() {

            const searchValue = searchInput.value.toLowerCase();
            const statusValue = statusFilter.value;

            tableCards.forEach(card => {

                const tableNumber = card.dataset.number.toLowerCase();
                const tableStatus = card.dataset.status;

                const matchesSearch =
                    tableNumber.includes(searchValue);

                const matchesStatus =
                    statusValue === "" ||
                    tableStatus === statusValue;

                if (matchesSearch && matchesStatus) {
                    card.style.display = "block";
                } else {
                    card.style.display = "none";
                }

            });
        }

        searchInput.addEventListener("input", filterTables);
        statusFilter.addEventListener("change", filterTables);
    </script>

</div>


@functions {
    public string GetTableImage(string zone)
    {
        if (string.IsNullOrEmpty(zone))
            return "https://i.pinimg.com/474x/1a/8f/c1/1a8fc1de823824330922567e057f5e13.jpg";

        zone = zone.ToLower();

        if (zone.Contains("море"))
            return "https://kalamakirestaurant.com/wp-content/uploads/2023/08/opengra.jpg";

        if (zone.Contains("плаж"))
            return "https://i.pinimg.com/474x/1a/8f/c1/1a8fc1de823824330922567e057f5e13.jpg";

        if (zone.Contains("градина"))
            return "https://theglossarymagazine.com/wp-content/uploads/2020/07/The-Berkeley-Terrace-JustinDeSouza-98-e1598568995367.jpg";

        if (zone.Contains("тераса"))
            return "https://i.pinimg.com/736x/c9/8f/92/c98f92087aa58b94799cee12f389b255.jpg";

        return "https://i.pinimg.com/736x/c9/8f/92/c98f92087aa58b94799cee12f389b255.jpg";
    }

}
