@model IEnumerable<ASPRestaurant.Data.Table>

@{
    ViewData["Title"] = "Маси";
}

<h1 class="section-title">Маси</h1>

<!-- ФИЛТРИ (оставяме ги) -->
<div class="filter-section mb-4">
    <div class="row">

        <div class="col-md-4">
            <input type="text" class="form-control" placeholder="Търси по номер..." id="searchInput">
        </div>

        <div class="col-md-4">
            <select class="form-control" id="statusFilter">
                <option value="">Всички маси</option>
                <option value="available">Свободни</option>
                <option value="unavailable">Заети</option>
            </select>
        </div>

    </div>
</div>

@if (User.IsInRole("Admin"))
{
    <div class="text-center mb-4">
        <a asp-action="Create" class="btn btn-primary">Нова маса</a>
    </div>
}

<!-- TABLES GRID (MASTER STYLE) -->
<div class="master-grid">

@foreach (var item in Model)
{
    <div class="master-card table-card @(item.IsAvailable ? "available" : "unavailable")">

       @*  <img src="@(item.ImageUrl ?? "https://via.placeholder.com/300x200")" /> *@

        <div class="master-card-body">

            <h3>Маса @item.TableNumber</h3>

            <p>@item.Count места</p>

            <p class="@(item.IsAvailable ? "table-free" : "table-reserved")">
                @(item.IsAvailable ? "Свободна" : "Заета")
            </p>

            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                Детайли
            </a>

            @if (User.Identity.IsAuthenticated && item.IsAvailable)
            {
                <a asp-controller="Reservations"
                   asp-action="Create"
                   asp-route-tableId="@item.Id"
                   class="btn btn-success btn-sm">
                    Резервирай
                </a>
            }

        </div>

    </div>
}

</div>