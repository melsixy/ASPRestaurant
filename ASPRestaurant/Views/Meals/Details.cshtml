@model ASPRestaurant.Data.Meal

@{
    ViewData["Title"] = Model.Name;
}

<div class="details-wrapper">

    <div class="details-card">

        <div class="details-image">
            <img src="@(Model.CoverImage ?? "https://via.placeholder.com/600x400")" />
        </div>

        <div class="details-body">

            <h1 class="details-title">@Model.Name</h1>

            <p class="details-desc">@Model.Alergens</p>

            <div class="details-info">

                <div class="info-box">
                    🍽 Категория: <strong>@Model.TypeOrders?.Name</strong>
                </div>

                <div class="info-box">
                    ⚠️ Алергени: <strong>@Model.Alergens</strong>
                </div>

                <div class="info-box">
                    💰 Цена: <strong>@Model.Price.ToString("F2") €</strong>
                </div>

            </div>

        </div>

    </div>

</div>
