@model IEnumerable<ASPRestaurant.Data.Meal>

@{
    ViewData["Title"] = "Ястия";
    var grouped = Model.GroupBy(x => x.TypeOrders?.Name ?? "Без категория");
}

<div class="container py-4">

    <h1 class="section-title text-center mb-4">Нашите ястия</h1>

    <!-- ФИЛТРИ -->
    <div class="filter-section mb-4">
        <div class="row justify-content-center">

            <div class="col-md-4 mb-2">
                <input type="text" class="form-control" placeholder="Търси..." id="searchInput">
            </div>

            <div class="col-md-4 mb-2">
                <select class="form-control" id="sortFilter">
                    <option value="name">По име</option>
                    <option value="price-asc">Цена ↑</option>
                    <option value="price-desc">Цена ↓</option>
                </select>
            </div>

        </div>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="text-center mb-4">
            <a asp-action="Create" class="btn btn-primary">
                Добави ястие
            </a>
        </div>
    }

    @foreach (var group in grouped)
    {
        <h2 class="category-title text-center mt-5 mb-3">
            @group.Key
        </h2>

        <div class="row justify-content-center">

            @foreach (var item in group)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4 d-flex justify-content-center">

                    <div class="drink-card meal-card">

                        <div class="drink-img">
                            <img src="@(string.IsNullOrEmpty(item.CoverImage)
                                        ? "https://via.placeholder.com/300x200"
                                        : item.CoverImage)"
                                 alt="@item.Name" />
                        </div>

                        <div class="drink-body">

                            <h3>@item.Name</h3>

                            <p>@item.Alergens</p>

                            <div class="drink-info">
                                <span>@item.TypeOrders?.Name</span>
                                <span class="price">@item.Price.ToString("F2") €</span>
                            </div>

                            <div class="drink-actions">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm">
                                    Детайли
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                        Редактирай
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">
                                        Изтрий
                                    </a>
                                }

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>