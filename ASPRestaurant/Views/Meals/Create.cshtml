@model ASPRestaurant.Data.Meal

@{
    ViewData["Title"] = "Добави ястие";
}

<div class="create-page">
    <div class="create-card">
        <h1>Добави ново ястие</h1>
        
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            
            <div class="form-group">
                <label asp-for="Name" class="form-label">Име на ястие</label>
                <input asp-for="Name" class="form-control" placeholder="Въведете име на ястието" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Alergens" class="form-label">Алергени</label>
                <textarea asp-for="Alergens" class="form-control" rows="3" placeholder="Съдържа: глутен, лактоза, ядки..."></textarea>
                <span asp-validation-for="Alergens" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Grammage" class="form-label">Грамаж (г)</label>
                        <input asp-for="Grammage" class="form-control" type="number" placeholder="250" />
                        <span asp-validation-for="Grammage" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Price" class="form-label">Цена (лв)</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="0.00" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="CoverImage" class="form-label">Снимка</label>
                <input asp-for="CoverImage" class="form-control" type="file" accept="image/*" />
                <span asp-validation-for="CoverImage" class="text-danger"></span>
                <small class="text-muted">Поддържани формати: JPG, PNG, GIF (макс. 5MB)</small>
            </div>

            <div class="form-group">
                <label asp-for="TypeOrderId" class="form-label">Категория</label>
                <select asp-for="TypeOrderId" class="form-control" asp-items="ViewBag.TypeOrderId">
                    <option value="">Изберете категория</option>
                </select>
                <span asp-validation-for="TypeOrderId" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Запази
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Назад
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Преглед на изображение преди качване
        document.getElementById('CoverImage').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    // Проверка дали вече има преглед
                    let preview = document.getElementById('imagePreview');
                    if (!preview) {
                        preview = document.createElement('img');
                        preview.id = 'imagePreview';
                        preview.className = 'img-thumbnail mt-2';
                        preview.style.maxWidth = '200px';
                        preview.style.maxHeight = '200px';
                        e.target.parentNode.appendChild(preview);
                    }
                    preview.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}